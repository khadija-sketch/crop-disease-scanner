    {
      "cell_type": "code",
      "source": [
        "# 1. Count how many red disease pixels we found\n",
        "disease_pixels = cv2.countNonZero(mask)\n",
        "\n",
        "# 2. Count healthy green pixels to find the total leaf area\n",
        "lower_green = np.array([25, 40, 40])\n",
        "upper_green = np.array([90, 255, 255])\n",
        "green_mask = cv2.inRange(hsv, lower_green, upper_green)\n",
        "healthy_pixels = cv2.countNonZero(green_mask)\n",
        "\n",
        "# 3. Calculate the exact infection percentage\n",
        "total_leaf_pixels = healthy_pixels + disease_pixels\n",
        "\n",
        "if total_leaf_pixels > 0:\n",
        "    severity = (disease_pixels / total_leaf_pixels) * 100\n",
        "else:\n",
        "    severity = 0\n",
        "\n",
        "print(f\"Exact Leaf Infection Severity: {severity:.2f}%\")"
