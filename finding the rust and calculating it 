      "source": [
        "import numpy as np\n",
        "\n",
        "# 1. Convert image to HSV color space and isolate rust colors\n",
        "hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)\n",
        "lower_rust = np.array([10, 50, 50])\n",
        "upper_rust = np.array([25, 255, 255])\n",
        "mask = cv2.inRange(hsv, lower_rust, upper_rust)\n",
        "\n",
        "# 2. Paint those exact spot pixels bright RED on a copy of the image\n",
        "result = img.copy()\n",
        "result[mask > 0] = [0, 0, 255]  # BGR format for Red\n",
        "\n",
        "# 3. Show the final highlighted image\n",
        "cv2_imshow(result)"
      ],
